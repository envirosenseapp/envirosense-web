@model EnviroSense.Web.ViewModels.Devices.MeasurementViewModel

@{
    ViewData["Title"] = "Device Measurements";
    var name = Model.DeviceName ?? "Unknown Device";
    var deviceId = Model.DeviceId;
}

<div class="container mt-4">
    <div class="card shadow-sm border-0 rounded-3">
        <div class="card-header bg-light d-flex justify-content-between align-items-center border-bottom">
            <div>
                <h2 class="card-title mb-0 text-primary">@ViewData["Title"]</h2>
                <small class="text-muted">for device: <strong>@name</strong></small>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm">
                    <i class="bi bi-arrow-left-circle"></i> Back to Devices
                </a>
                <a asp-controller="Devices"
                   asp-action="Graph"
                   asp-route-id="@deviceId"
                   class="btn btn-outline-warning btn-sm">
                    <i class="bi bi-graph-up"></i> Switch to graph mode
                </a>
                <a asp-controller="Devices" asp-action="Details" asp-route-id="@deviceId"
                   class="btn btn-outline-primary btn-sm">
                    <i class="bi bi-info-circle"></i> View Device Details
                </a>
                <a href="@Url.Action("AddMeasurements", "Devices", new { deviceId = @deviceId })"
                   class="btn btn-outline-success btn-sm shadow-sm">
                    <i class="bi bi-plus-circle-dotted me-1"></i> Add Measurement
                </a>
            </div>
        </div>

        <div class="card-body">

            @if (!Model.Measurements.Any())

            {
                <div class="text-center py-5">
                    <h5 class="text-muted mb-3">No measurements found</h5>
                    <p class="mb-4">You can add a measurement to start tracking your device data.</p>
                    <a href="@Url.Action("AddMeasurements", "Devices", new { deviceId = @deviceId })"
                       class="btn btn-outline-success btn-sm shadow-sm">
                        <i class="bi bi-plus-circle-dotted me-1"></i> New Measurement
                    </a>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-striped align-middle">
                        <thead class="table-primary">
                        <tr>
                            <th>ID</th>
                            <th>Device ID</th>
                            <th>Device DeviceName</th>
                            <th>🌡️ Temperature</th>
                            <th>💧 Humidity</th>
                            <th>📅 Recording Date</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var measurement in Model.Measurements)
                        {
                            <tr>
                                <td class="fw-bold">@measurement.Id</td>
                                <td>@Model.DeviceId</td>
                                <td>@measurement.DeviceName</td>
                                <td>
                                    <span class="badge bg-warning text-dark px-3 py-2">
                                        @measurement.Temperature&nbsp;°C
                                    </span>
                                </td>
                                <td>
                                    <span class="badge bg-info text-dark px-3 py-2">
                                        @measurement.Humidity&nbsp;%
                                    </span>
                                </td>
                                <td>@measurement.RecordingDate.ToString("dd/MM/yyyy HH:mm")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
        <div class="d-flex justify-content-center mt-3 mb-3">
            @if (Model.PageIndex > 0)
            {
                <a asp-action="Measurements"
                   asp-route-deviceId="@Model.DeviceId"
                   asp-route-pageIndex="@(Model.PageIndex-1)"
                   class="btn btn-outline-primary btn-sm me-2">
                    Previous page
                </a>
            }

            @if (Model.PageIndex < Model.TolalPages)
            {
                <a asp-action="Measurements"
                   asp-route-deviceId="@Model.DeviceId"
                   asp-route-pageIndex="@(Model.PageIndex + 1)"
                   class="btn btn-outline-primary btn-sm ms-2">
                    Next page
                </a>
            }
        </div>
    </div>
</div>
