@model EnviroSense.Domain.Emailing.SendPasswordResetLinkEmailPayload

Reset Password<br>
<p>Hi @Model.PasswordResetEmail,</p>
<p>We received a request to reset your password for your account on EnviroSense.</p>
<p>To create a new password, click the link below:<br/>
    <a href="@Model.PasswordResetLink">Reset it here</a></p>


<p>Thank you,</p>
The EnviroSense Team",
@Model.GeneratedAt.ToString("F")
