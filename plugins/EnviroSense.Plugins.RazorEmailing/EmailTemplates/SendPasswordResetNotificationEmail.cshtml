@model EnviroSense.Domain.Emailing.SendPasswordResetedNotificationEmailPayload


Password has been reset,<br>
<p>Hi @Model.PasswordResetEmail,</p>
<p>Your password has been reset.</p>
<p>Log in with your new password now:<br/>
    <a href="@Model.RedirectLink">Sign in here</a></p>

<p>Thanks,<br/>The EnviroSense Team</p><br> @Model.LoginDate.ToString("F")
